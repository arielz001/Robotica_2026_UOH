<mujoco model="robot_antropomorfico_Z_Y_estable">
    <compiler angle="degree" coordinate="local"/>
    <option timestep="0.002" integrator="RK4"/>

    <visual>
        <headlight ambient="0.5 0.5 0.5"/>
    </visual>

    <worldbody>
        <light pos="0 0 3" dir="0 0 -1"/>
        <geom name="suelo" type="plane" size="2 2 0.1" rgba="0.9 0.9 0.9 1"/>

        <body name="base" pos="0 0 0.1">
            <geom name="base_geom" type="box" size="0.2 0.2 0.1" rgba="0.3 0.3 0.3 1"/>
            
            <body name="eslabon1" pos="0 0 0.1" gravcomp="1.0">
                <joint name="j1" type="hinge" axis="0 0 1" pos="0 0 0" range="-180 180" damping="1.0" armature="0.1"/>
                <geom name="brazo1" type="capsule" fromto="0 0 0  0 0 0.5" size="0.04" rgba="0.2 0.6 0.2 1" mass="2.0"/>

                <body name="eslabon2" pos="0 0 0.5" gravcomp="1.0">
                    <joint name="j2" type="hinge" axis="0 1 0" pos="0 0 0" range="-150 150" damping="1.0" armature="0.1"/>
                    <geom name="brazo2" type="capsule" fromto="0 0 0  0 0 0.4" size="0.03" rgba="0.2 0.2 0.8 1" mass="1.5"/>
                    
                    <body name="pinza" pos="0 0 0.4">
                        <geom type="box" size="0.02 0.06 0.01" rgba="0.8 0.2 0.2 1" mass="0.3"/>
                        <geom type="box" size="0.04 0.01 0.03" pos="0.02 0.05 0.02" rgba="0.8 0.2 0.2 1" mass="0.1"/>
                        <geom type="box" size="0.04 0.01 0.03" pos="0.02 -0.05 0.02" rgba="0.8 0.2 0.2 1" mass="0.1"/>
                    </body>
                </body>
            </body>
        </body>
    </worldbody>

    <actuator>
        <position name="servo_j1" joint="j1" kp="400" kv="40"/>
        <position name="servo_j2" joint="j2" kp="300" kv="25"/>
    </actuator>
</mujoco>